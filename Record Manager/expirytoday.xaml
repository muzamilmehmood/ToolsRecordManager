<Page x:Class="Record_Manager.expirytoday"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Record_Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="expirytoday">

    <Border CornerRadius="30"
            Background="#272537"
            Margin="5"
            BorderThickness="2"
            BorderBrush="White">
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Expiry Date:"
                       Foreground="White" FontSize="14"
                       Margin="20,0,10,0"/>
                <DatePicker x:Name="expDate" FontSize="16" Width="220" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      x:Name="expiryDataGrid" AutoGenerateColumns="False"
                      Background="Transparent" BorderThickness="0"
                      FontSize="14" 
                      Margin="20,0,20,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ID}" ClipboardContentBinding="{x:Null}" Header="ID"/>
                    <DataGridTextColumn Binding="{Binding Name}" ClipboardContentBinding="{x:Null}" Header="Name" Width="120"/>
                    <DataGridTextColumn Binding="{Binding PhoneNumber}" ClipboardContentBinding="{x:Null}" Header="Phone Number" Width="100"/>
                    <DataGridTextColumn Binding="{Binding ToolName}" ClipboardContentBinding="{x:Null}" Header="Tool Name" Width="150"/>
                    <DataGridTextColumn Binding="{Binding DOR}" ClipboardContentBinding="{x:Null}" Header="Date of Reg" Width="90"/>
                    <DataGridTextColumn Binding="{Binding DOE}" ClipboardContentBinding="{x:Null}" Header="Date of Exp" Width="90"/>
                    <DataGridTextColumn Binding="{Binding PaymentMode}" ClipboardContentBinding="{x:Null}" Header="Payment Mode" Width="80" />
                    <DataGridTextColumn Binding="{Binding Payment}" ClipboardContentBinding="{x:Null}" Header="Payment" Width="80" />
                    <DataGridTextColumn Binding="{Binding Amount}" ClipboardContentBinding="{x:Null}" Header="Amount" Width="*" />
                </DataGrid.Columns>
                
            </DataGrid>
            
        </Grid>
    </Border>
</Page>

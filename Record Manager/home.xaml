<Window x:Class="Record_Manager.home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Record_Manager"
        mc:Ignorable="d"
        Title="home" Height="600" Width="1080" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True" Icon="appicon.png">

    <Border Background="#272537"
            CornerRadius="20">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="75" />
                <RowDefinition />
            </Grid.RowDefinitions>
            
            <!--TRM LOGO-->
            <Label Content="TRM"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="White"
                   FontSize="22" FontWeight="Bold"/>
            
            <!--TRM Header-->
            <Label x:Name="lbl1"  Grid.Column="1"
                    Content="DASHBOARD"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="22"/>

            <Label x:Name="lbl2"  Grid.Column="1" HorizontalAlignment="Right"
                    Content="V1.1.8"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="14" Margin="0,0,30,0"/>

            <Rectangle  Grid.Column="1"
                        Width="820"
                        Height="5"
                        VerticalAlignment="Bottom"
                        Fill="DodgerBlue"/>


            <!--TRM NAV BAR-->
            <StackPanel Grid.Row="1" Grid.Column="0">

                <Button x:Name="dashboard" Content="Dashboard"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0" Click="dashboard_Click"/>

                <Button x:Name="addUser" Content="Add User"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0" Click="addUser_Click" />

                <Button x:Name="record" Content="All Records"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0" Click="record_Click"/>

                <Button x:Name="search" Content="Search Users"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0" Click="search_Click"/>

                <Button x:Name="edit" Content="Edit Record"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0" Click="edit_Click"/>

                <Button x:Name="exp_today" Content="Tool Expiries"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0" Click="exp_today_Click"/>

                <Button x:Name="importBtn" Content="Import Data"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0" Click="importBtn_ClickAsync" />

                <Button x:Name="exportBtn" Content="Export Data"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0" Click="exportBtn_Click"/>


                <Button x:Name="sign_out" Content="Sign Out"
                        Height="50"
                        Foreground="White" Background="Transparent"
                        FontSize="16"
                        BorderThickness="0"
                        Margin="0,60,0,0" Click="sign_out_Click"/>

            </StackPanel>
            
            <!--TRM Dashboard page-->
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">

                <Border Width="250"
                        Height="200"
                        VerticalAlignment="Top"
                        Background="#F2F3F4"
                        Margin="35,40,10,20"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                               Content="Active Orders"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Center"/>

                        <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                               Content="00"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Top"/>

                    </Grid>

                </Border>

                <Border Width="250"
                        Height="200"
                        VerticalAlignment="Top"
                        Background="#FF51E279"
                        Margin="20,40,20,20"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                               Content="Orders Completed"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Center"/>

                        <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                               Content="00"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Top"/>

                    </Grid>

                </Border>

                <Border Width="250"
                        Height="200"
                        VerticalAlignment="Top"
                        Background="#FFF05858"
                        Margin="10,40,0,20"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                               Content="Cancelled Orders"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Center"/>

                        <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                               Content="00"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Top"/>

                    </Grid>

                </Border>

            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                <Border Width="400"
                        Height="200"
                        VerticalAlignment="Bottom"
                        Background="#FF0B89F1"
                        Margin="30,0,15,40"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                               Content="Orders This Month"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Center"/>

                        <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                               Content="00"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Top"/>

                    </Grid>

                </Border>

                <Border Width="400"
                        Height="200"
                        VerticalAlignment="Bottom"
                        Background="#FFBF00"
                        Margin="10,40,20,40"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                               Content="Total Earning"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Center"/>

                        <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                               Content="00"
                               FontFamily="./fonts/#Poppins"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalContentAlignment="Top"/>

                    </Grid>

                </Border>

            </StackPanel>

            <Frame x:Name="mainframe" Grid.Column="1" Grid.Row="1"
                   NavigationUIVisibility="Hidden"/>

        </Grid>
        
    </Border>
    
</Window>

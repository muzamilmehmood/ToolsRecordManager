<Page x:Class="Record_Manager.addUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Record_Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="addUser" Background="Transparent">

    <Border CornerRadius="30"
            Background="#272537"
            Margin="5"
            BorderThickness="2"
            BorderBrush="White">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Margin="20,20,20,20" Grid.RowSpan="2" >
                <Label Content="Name:"
                       Foreground="White"
                       FontSize="16"/>

                <TextBox x:Name="nameText" FontSize="16"/>

                <Label Content="Phone Number:"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,20,0,0"/>

                <TextBox x:Name="phoneNumberText" FontSize="16"/>

                <Label Content="Location:"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,20,0,0"/>

                <TextBox x:Name="locationText" FontSize="16"/>

                <Label Content="Date of Registery:"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,20,0,0"/>
                
                <DatePicker x:Name="DORText" FontSize="16"
                            Margin="0,0,0,0"/>

                <Label Content="Date of Expiry:"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,20,0,0"/>

                <DatePicker x:Name="DOEText" FontSize="16"
                            Margin="0,0,0,0"/>

            </StackPanel>

            <StackPanel Margin="20" Grid.Column="1" Grid.RowSpan="2">

                <Label Content="Tool Name and Description:"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,0,0,0"/>

                <TextBox  x:Name="toolNameText" FontSize="16" Background="White" Foreground="Black" 
                          AcceptsReturn="True" AcceptsTab="True"
                          Height="110"
                          Margin="0,0,0,20" TextWrapping="Wrap" />

                <Label Content="Mode of Payment:"
                       Foreground="White"
                       FontSize="16"/>

                <TextBox x:Name="modeOfPaymentText" FontSize="16"/>

                <Label Content="Amount:"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,20,0,0"/>

                <TextBox x:Name="amountText" FontSize="16"/>

                <Label Content="Pending/Received:"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,20,0,0"/>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="receivedText" Content="Received" Foreground="White" FontSize="14" Margin="0,10,20,0" Checked="receivedText_Checked" />
                    <RadioButton x:Name="pendingText" Content="Pending" Foreground="White" FontSize="14" Margin="0,10,0,0" Checked="pendingText_Checked"/>
                </StackPanel>

            </StackPanel>

            <Button Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    x:Name="addBtn" Content="ADD"
                    Height="40" Width="150" BorderThickness="2"
                    BorderBrush="DodgerBlue"
                    Background="Transparent"
                    Foreground="White"
                    FontSize="16"
                    Margin="20" Click="addBtn_Click"/>


        </Grid>

    </Border>

    
</Page>

<Page x:Class="Record_Manager.search"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Record_Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="search">

    <Border CornerRadius="30"
            Background="#272537"
            Margin="5"
            BorderThickness="2"
            BorderBrush="White">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <!--Search Bar-->
            <StackPanel Orientation="Horizontal">
                <Label Content="Search by name"
                       Foreground="White" FontSize="14"
                       Margin="170,10,0,0"/>

                <Label Content="Search by tool"
                       Foreground="White" FontSize="14"
                       Margin="160,10,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">

                <TextBox x:Name="searchByName" 
                         Width="250" Height="30"
                         FontSize="16" Margin="10,0,10,0" TextChanged="searchByName_TextChanged"/>

                <TextBox x:Name="searchByTool" Width="250" Height="30"
                         FontSize="16" Margin="10,0,10,0" TextChanged="searchByTool_TextChanged"/>

            </StackPanel>

            <DataGrid Grid.Row="1"
                      x:Name="searchDataGrid" AutoGenerateColumns="False"
                      Background="Transparent" BorderThickness="0"
                      FontSize="14" 
                      Margin="20,20,20,10">

                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ID}" ClipboardContentBinding="{x:Null}" Header="ID"/>
                    <DataGridTextColumn Binding="{Binding Name}" ClipboardContentBinding="{x:Null}" Header="Name" Width="120"/>
                    <DataGridTextColumn Binding="{Binding PhoneNumber}" ClipboardContentBinding="{x:Null}" Header="Phone Number" Width="100"/>
                    <DataGridTextColumn Binding="{Binding ToolName}" ClipboardContentBinding="{x:Null}" Header="Tool Name" Width="150"/>
                    <DataGridTextColumn Binding="{Binding DOR}" ClipboardContentBinding="{x:Null}" Header="Date of Reg" Width="90"/>
                    <DataGridTextColumn Binding="{Binding DOE}" ClipboardContentBinding="{x:Null}" Header="Date of Exp" Width="90"/>
                    <DataGridTextColumn Binding="{Binding PaymentMode}" ClipboardContentBinding="{x:Null}" Header="Payment Mode" Width="80" />
                    <DataGridTextColumn Binding="{Binding Payment}" ClipboardContentBinding="{x:Null}" Header="Payment" Width="80" />
                    <DataGridTextColumn Binding="{Binding Amount}" ClipboardContentBinding="{x:Null}" Header="Amount" Width="*" />
                </DataGrid.Columns>



            </DataGrid>

        </Grid>
    </Border>
</Page>
